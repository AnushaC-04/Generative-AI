   "source": [
    "with open('data.txt','r+') as file:\n",
    "    data=file.read()\n",
    "print(data)\n",
    "chunks=[]\n",
    "fixed_size=10\n",
    "for index in range (0,len(data),fixed_size):\n",
    "    chunk=data[index:index+fixed_size]\n",
    "    # print(chunk,len(chunk))\n",
    "    chunks.append(chunk)\n",
    "print(chunks)"
