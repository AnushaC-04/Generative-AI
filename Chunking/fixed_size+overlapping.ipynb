   "source": [
    "with open('data.txt','r+') as file:\n",
    "    data=file.read()\n",
    "print(data)\n",
    "chunks=[]\n",
    "fixed_size=20\n",
    "overlapping=4\n",
    "for index in range (0,len(data),fixed_size-overlapping):\n",
    "    chunk=data[index:index+fixed_size]\n",
    "    # print(chunk,len(chunk))\n",
    "    chunks.append(chunk)\n",
    "print(chunks)"
